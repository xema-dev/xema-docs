{
  "name": "xema-docs",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.17.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Neuralchowder Inc. <developer@xema.dev> (https://xema.dev)",
  "homepage": "https://xema.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xema-dev/xema-docs.git"
  },
  "bugs": "https://github.com/xema-dev/xema-docs/issues",
  "scripts": {
    "prepare": "node -e \"require('fs').existsSync('.git')&&require('child_process').execFileSync('node',['tooling/ci/generated/git-hooks/install-git-hooks.mjs'],{stdio:'inherit'})\"",
    "check": "node tooling/boundaries/lib/source-readability.mjs && npm run check:arm64-supplement-probe && npm run check:docs-server && npm run check:service-registry-keyspace && npm run check:concept-frontmatter",
    "build": "astro build",
    "check:arm64-supplement-probe": "node --test tooling/release/arm64-supplement-needed.test.mjs",
    "check:concept-frontmatter": "node tooling/boundaries/check-concept-frontmatter.mjs --self-test && node tooling/boundaries/check-concept-frontmatter.mjs",
    "check:docs-server": "node --test service/__tests__/docs-server.test.mjs",
    "check:service-registry-keyspace": "node --test service/__tests__/service-registry.test.mjs",
    "check:source-readability": "node tooling/boundaries/lib/source-readability.mjs",
    "dev": "astro dev",
    "preview": "astro preview"
  },
  "devDependencies": {
    "astro": "^7.2.2",
    "js-yaml": "^4.1.0",
    "lefthook": "^2.1.10"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "svgo": "^4.0.2"
  }
}
